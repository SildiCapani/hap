{
  "expo": {
    "name": "Hap",
    "slug": "Hap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "hap",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0D",
        "foregroundImage": "./assets/images/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "name": "Hap",
      "shortName": "Hap",
      "display": "standalone",
      "bundler": "metro",
      "themeColor": "#0B0B0D",
      "backgroundColor": "#0B0B0D",
      "favicon": "./assets/images/logo.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0D",
          "image": "./assets/images/logo.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F07B83"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Hap nutzt deine Fotos, um die Kalorien deiner Mahlzeiten zu schätzen.",
          "cameraPermission": "Hap nutzt die Kamera, um die Kalorien deiner Mahlzeiten zu schätzen.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Hap nutzt die Kamera, um Barcodes von Lebensmitteln zu scannen.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
