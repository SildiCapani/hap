# Configure these in Netlify, scoped to Functions. Never use EXPO_PUBLIC_ for secrets.
OPENAI_API_KEY=
# Choose an available Responses API model supporting Structured Outputs.
OPENAI_MODEL=
# Paste the instructions from your existing Weekly Meal Plan and Groceries task.
MEAL_PLAN_PROMPT=
# Generate TWO DIFFERENT random values, each at least 32 characters.
HAP_ACCESS_TOKEN=
HAP_JOB_SECRET=
# Web push for the home screen app. Create once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:dein-name@example.com
VAPID_SUBJECT=
# Optional: separate model for food photo analysis (needs image input). Defaults to OPENAI_MODEL.
FOOD_MODEL=
